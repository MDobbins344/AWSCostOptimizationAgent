# Copy to .env and fill in locally. NEVER commit the real .env.
# AWS auth is best handled via a named profile or role; these are here for convenience.

# --- LLM provider (default: Claude API). Check https://docs.claude.com for current model IDs. ---
ANTHROPIC_API_KEY=
LLM_MODEL=            # e.g. a current Claude model id from the docs

# --- AWS (read-only role/profile) ---
AWS_PROFILE=          # preferred: a local profile mapped to the read-only role
AWS_REGION=us-east-1

# --- Scan tuning ---
CLOUDWATCH_LOOKBACK_DAYS=14
